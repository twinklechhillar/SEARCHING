class Main {
    public static void main(String[] args) {

        int[] arr = {5, 2, 8, 2, 9};
        int target = 2;

        int firstIndex = -1;

        for(int i = 0; i < arr.length; i++) {

            if(arr[i] == target) {
                firstIndex = i;
                break;
            }
        }

        if(firstIndex != -1) {
            System.out.println("First occurrence at index " + firstIndex);
        } else {
            System.out.println("Not Found");
        }
    }
}
